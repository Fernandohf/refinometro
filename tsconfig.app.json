{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "skipLibCheck": true,
    // `vite/client` traz o tipo de `import.meta.env`, de onde a tela lê o
    // `BASE_URL` para montar os links internos (ver `components/Sobre.tsx`).
    // `node` continua na lista porque declarar `types` desliga o padrão, e os
    // `scripts/` deste projeto rodam no Node e usam `process`.
    "types": ["vite/client", "node"],
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo"
  },
  "include": ["src", "tests", "scripts"]
}
