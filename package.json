{
  "name": "refinometro",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "data:fetch": "node scripts/fetch-gnjoy.mjs",
    "data:parse": "node scripts/parse-gnjoy.mjs",
    "data:items": "vite-node scripts/atualizar-base.ts --",
    "test:watch": "vitest",
    "perf": "vite-node scripts/perf.ts",
    "demo": "vite-node scripts/demo.ts",
    "descricoes": "vite-node scripts/descricoes.ts",
    "item": "vite-node scripts/fetch-item.ts --",
    "buscar": "vite-node scripts/buscar.ts --",
    "precos": "vite-node scripts/precos-latam.ts --"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vite-node": "^6.0.0",
    "vitest": "^4.1.11"
  }
}
